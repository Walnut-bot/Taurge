# Taurge API — exemple de configuration (copier vers .env)
# Mode actuel : API en local sur le PC, frontend sur Vercel.
# SQLite par défaut ; CORS_ORIGINS doit contenir le domaine Vercel
# (déjà autorisé par défaut dans le code, ce réglage est un plus).
DATABASE_URL=sqlite:///./taurge.db
ENVIRONMENT=development
SECRET_KEY=dev-secret-change-me
# Durée de vie JWT en minutes (défaut 720 = 12 h, max recommandé 1440)
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=https://taurge.vercel.app
STORAGE_PATH=./storage_data
MAX_UPLOAD_SIZE_MB=50
# File de tâches Celery + Redis : auto (défaut, Celery si le broker
# répond, sinon worker DB intégré), true (force) ou false (désactive).
# Worker dédié : celery -A app.jobs.celery_app worker --pool=solo -l info
USE_CELERY=auto
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Stockage : local (défaut) ou s3 (S3-compatible, boto3 optionnel : pip install -r requirements-s3.txt)
STORAGE_PROVIDER=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=
PUBLIC_APP_URL=https://taurge.vercel.app

# OCR : budget max par page en secondes (défaut 240). Moteurs lourds
# optionnels (PaddleOCR/MangaOCR) : pip install -r requirements-ocr.txt
# ou docker build --build-arg INSTALL_OCR=true. Sans eux : repli Tesseract.
OCR_TIMEOUT_SECONDS=240

# Traduction : Ollama local prioritaire (aucune clé requise)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_BUDGET_WITH_FALLBACK_SECONDS=30

# Traduction : fallback DeepL API Free (clé se terminant par :fx)
DEEPL_API_KEY=
DEEPL_API_BASE_URL=https://api-free.deepl.com
DEEPL_TIMEOUT_SECONDS=30

# Paiements — mode test : sans ces clés, le checkout répond 503 (rien n'est simulé)
# FedaPay (Afrique francophone, Mobile Money/cartes) — clé de test
FEDAPAY_SECRET_KEY_TEST=
FEDAPAY_WEBHOOK_SECRET=
FEDAPAY_API_BASE_URL=https://sandbox-api.fedapay.com/v1
# Montants XOF entiers par pack (aucune conversion EUR→XOF automatique)
FEDAPAY_AMOUNT_XOF_DISCOVERY=
FEDAPAY_AMOUNT_XOF_REGULAR=
FEDAPAY_AMOUNT_XOF_STUDIO=
# Paddle (international) — sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_API_BASE_URL=https://sandbox-api.paddle.com
PADDLE_PRICE_ID_DISCOVERY=
PADDLE_PRICE_ID_REGULAR=
PADDLE_PRICE_ID_STUDIO=
