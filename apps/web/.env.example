# URL de l'API, SANS slash final.
# Architecture actuelle : API FastAPI EN LOCAL sur le PC de
# l'utilisateur, frontend sur Vercel. En local : http://localhost:8000
# (défaut si la variable est absente). Pour le site Vercel, aucun
# réglage ici : lancer LANCER_TAURGE_TUNNEL.bat à la racine, il ouvre
# le site avec ?api=<url-du-tunnel> que le navigateur mémorise.
# Cette variable ne sert que si un backend distant revient un jour.
NEXT_PUBLIC_API_URL=http://localhost:8000
