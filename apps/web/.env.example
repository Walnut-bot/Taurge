# URL de l'API, SANS slash final (ex. https://taurge-api.onrender.com)
# Un slash final produirait des appels en `//auth/...` (404 « Not Found »).
# En local : http://localhost:8000 (défaut si la variable est absente et
# que le site tourne sur localhost). Sur Vercel, cette variable est
# définie au build par vercel.json ; sans elle, le code retombe sur
# l'API Render en production — jamais sur localhost chez le visiteur.
NEXT_PUBLIC_API_URL=http://localhost:8000
